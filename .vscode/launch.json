{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "server:app",
        "--reload",
        "--workers",
        "1",
        "--host",
        "0.0.0.0",
        "--port",
        "8091"
      ],
      "jinja": true
    },
    {
      "name": "Debug Main",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/{{ cookiecutter.module_name }}/main.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    }
  ]
}
