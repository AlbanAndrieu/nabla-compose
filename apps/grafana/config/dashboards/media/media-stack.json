    {
      "id": 9,
      "type": "table",
      "title": "Problèmes de santé signalés",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "{__name__=~\"(radarr|sonarr|lidarr|prowlarr|bazarr)_system_health_issues\"} > 0",
