logging {
  level = "info"
}

loki.relabel "pfsense_syslog" {
  forward_to = [loki.write.default.receiver]

  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }

  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "app"
  }

  rule {
    source_labels = ["__syslog_message_severity"]
    target_label  = "severity"
  }

  rule {
    source_labels = ["__syslog_message_facility"]
    target_label  = "facility"
  }

  rule {
    source_labels = ["__syslog_connection_ip_address"]
    regex         = "172\\.17\\.0\\.1"
    target_label  = "device"
    replacement   = "pfsense"
  }
}

loki.source.syslog "pfsense" {
  listener {
    address                = "0.0.0.0:1514"
    protocol               = "udp"
    syslog_format          = "rfc5424"
    use_incoming_timestamp = true
    udp_queue_size         = 1024

    labels = {
      environment = "homelab",
      job         = "pfsense",
      source      = "remote-syslog",
    }
  }

  relabel_rules = loki.relabel.pfsense_syslog.rules
  forward_to    = [loki.write.default.receiver]
}

loki.source.file "security" {
  targets = [
    {
      __path__ = sys.env("PFSENSE_FILE_GLOB"),
      job      = "pfsense-legacy",
    },
    {
      __path__ = "/var/log/suricata/*.json",
      job      = "suricata",
    },
  ]
  forward_to = [loki.write.default.receiver]

  file_match {
    enabled = true
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4319"
  }

  http {
    endpoint = "0.0.0.0:4320"
  }

  output {
    logs    = [otelcol.exporter.loki.default.input]
    metrics = [otelcol.exporter.prometheus.mimir.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

otelcol.exporter.prometheus "mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
