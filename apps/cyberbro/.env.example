# Cyberbro runtime credentials are materialized from Vaultwarden into:
# /mnt/cpool/secrets/runtime/cyberbro/.env.secrets
#
# The application starts without provider credentials and still exposes its free engines.
# Populate only the integrations you intend to use; optional provider fields may remain empty.

ABUSEIPDB=
ALIENVAULT=
CRIMINALIP_API_KEY=
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
DFIR_IRIS_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_KEY=
GOOGLE_SAFE_BROWSING=
HISTER_TOKEN=
IPAPI=
IPINFO=
MDE_CLIENT_ID=
MDE_CLIENT_SECRET=
MDE_TENANT_ID=
MISP_API_KEY=
MISP_FEEDBACK_TOKEN=
OPENCTI_API_KEY=
RANSOMWARE_LIVE_API_KEY=
RL_ANALYZE_API_KEY=
ROSTI_API_KEY=
SHODAN=
SPUR_US=
THREATFOX=
VIRUSTOTAL=
WEBSCOUT=

# Non-secret integration endpoints/configuration can be supplied as Compose project variables.
# CYBERBRO_CROWDSTRIKE_FALCON_BASE_URL=https://falcon.crowdstrike.com
# CYBERBRO_DFIR_IRIS_URL=https://dfir-iris.local
