#!/usr/bin/with-contenv bash
# shellcheck shell=bash

set -euo pipefail

readonly extension_id="saoudrizwan.claude-dev"

if s6-setuidgid abc /app/code-server/bin/code-server \
  --extensions-dir /config/extensions \
  --list-extensions | grep -Fxq "${extension_id}"; then
  echo "[custom-init] Extension already installed: ${extension_id}"
  exit 0
fi

echo "[custom-init] Installing extension from Open VSX: ${extension_id}"
install-extension "${extension_id}"
