{
  "mcpServers": {
    "truenas-readonly": {
      "type": "stdio",
      "command": "bash",
      "args": ["scripts/mcp/truenas-readonly.sh"]
    },
    "nabla-mcp": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "scripts/mcp/http-remote.sh",
        "litellm-gateway",
        "http://172.17.0.24:4000/mcp/"
      ]
    },
    "uptime-kuma": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@davidfuchs/mcp-uptime-kuma@0.11.9"],
      "env": {
        "UPTIME_KUMA_URL": "${UPTIME_KUMA_URL}",
        "UPTIME_KUMA_USERNAME": "${UPTIME_KUMA_USERNAME}",
        "UPTIME_KUMA_PASSWORD": "${UPTIME_KUMA_PASSWORD}",
        "UPTIME_KUMA_INCLUDE_SECRETS": "false"
      }
    },
    "bitwarden-local": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@bitwarden/mcp-server@2026.7.0"],
      "env": {
        "BW_SESSION": "${BW_SESSION}",
        "BW_CLI_PATH": "${BW_CLI_PATH:-bw}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "freshrss-security-readonly": {
      "type": "stdio",
      "command": "python3",
      "args": ["scripts/mcp/freshrss_readonly.py"],
      "env": {
        "FRESHRSS_MCP_AUTH": "${FRESHRSS_MCP_AUTH}",
        "FRESHRSS_CF_ACCESS_CLIENT_ID": "${FRESHRSS_CF_ACCESS_CLIENT_ID}",
        "FRESHRSS_CF_ACCESS_CLIENT_SECRET": "${FRESHRSS_CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    }
  }
}
