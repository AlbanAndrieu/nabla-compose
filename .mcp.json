{
  "mcpServers": {
    "truenas-readonly": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@profanter-dev/truenas-mcp@1.0.6"
      ],
      "env": {
        "TRUENAS_HOST": "${TRUENAS_MCP_HOST}",
        "TRUENAS_API_KEY": "${TRUENAS_MCP_API_KEY}",
        "TRUENAS_INSECURE": "${TRUENAS_MCP_INSECURE:-false}"
      }
    },
    "homarr": {
      "type": "http",
      "url": "${HOMARR_MCP_URL}",
      "headers": {
        "ApiKey": "${HOMARR_API_KEY}"
      }
    },
    "gatus": {
      "type": "http",
      "url": "${GATUS_MCP_URL}"
    },
    "uptime-kuma": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@davidfuchs/mcp-uptime-kuma@0.11.9"
      ],
      "env": {
        "UPTIME_KUMA_URL": "${UPTIME_KUMA_URL}",
        "UPTIME_KUMA_USERNAME": "${UPTIME_KUMA_USERNAME}",
        "UPTIME_KUMA_PASSWORD": "${UPTIME_KUMA_PASSWORD}",
        "UPTIME_KUMA_INCLUDE_SECRETS": "false"
      }
    },
    "bitwarden-local": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@bitwarden/mcp-server@2026.7.0"
      ],
      "env": {
        "BW_SESSION": "${BW_SESSION}",
        "BW_CLI_PATH": "${BW_CLI_PATH:-bw}"
      }
    },
    "fastapi-sample": {
      "type": "http",
      "url": "${FASTAPI_SAMPLE_MCP_URL:-http://172.17.0.24:8091/mcp}"
    },
    "grafana": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--read-only",
        "--cap-drop=ALL",
        "--security-opt=no-new-privileges",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "grafana/mcp-grafana:1.2.0-alpine",
        "-t",
        "stdio",
        "--disable-write"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    },
    "sentry": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@sentry/mcp-server@0.39.0",
        "--host=172.17.0.24:9005",
        "--insecure-http",
        "--skills=inspect",
        "--disable-skills=seer",
        "--sentry-dsn="
      ],
      "env": {
        "SENTRY_ACCESS_TOKEN": "${SENTRY_ACCESS_TOKEN}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "defectdojo": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/dcianciulli/defectdojo-mcp-server@4d34d17f346dccab92e97e3d50e77b568689f283",
        "defectdojo-mcp-server"
      ],
      "env": {
        "DEFECTDOJO_URL": "${DEFECTDOJO_URL}",
        "DEFECTDOJO_API_KEY": "${DEFECTDOJO_API_KEY}"
      }
    },
    "freshrss-security-readonly": {
      "type": "stdio",
      "command": "python3",
      "args": ["scripts/mcp/freshrss_readonly.py"],
      "env": {
        "FRESHRSS_MCP_AUTH": "${FRESHRSS_MCP_AUTH}",
        "FRESHRSS_CF_ACCESS_CLIENT_ID": "${FRESHRSS_CF_ACCESS_CLIENT_ID}",
        "FRESHRSS_CF_ACCESS_CLIENT_SECRET": "${FRESHRSS_CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    }
  }
}
