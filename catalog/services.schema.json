{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.albanandrieu.com/schemas/nabla-services.schema.json",
  "title": "Nabla declared service catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "catalogRevision",
    "topologyVersion",
    "name",
    "services"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "catalogRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "topologyVersion": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "external", "cloudflareTunnel"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "external": {
          "type": "boolean"
        },
        "cloudflareTunnel": {
          "type": "boolean"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["truenas-app", "logical", "external", "host"]
        },
        "appId": {
          "type": "string",
          "minLength": 1
        },
        "containerService": {
          "type": "string",
          "minLength": 1
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "priority"],
      "properties": {
        "phase": {
          "enum": [
            "bootstrap-runtime",
            "foundation",
            "network-edge",
            "primary-data",
            "secondary-data",
            "platform-services",
            "applications"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "category",
        "sourcePath",
        "composeService"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "presentationRole": {
          "enum": ["service", "core", "support"]
        },
        "criticality": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "securityFunctions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "govern",
              "identify",
              "protect",
              "detect",
              "respond",
              "recover"
            ]
          }
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "composeService": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/environment"
          }
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "monitoring": {
          "$ref": "#/$defs/monitoring"
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["http", "port"]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
