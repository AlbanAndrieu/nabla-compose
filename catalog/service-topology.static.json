  "relations": [
    {
      "source": "kubernetes",
      "target": "etcd",
      "type": "dependsOn",
      "strength": "required",
      "description": "Kubernetes control-plane availability depends on a healthy etcd state store.",
      "evidence": [
        "docs/homelab-health-observability.md:etcd direct health gate and control-plane criticality"
      ]
    },
    {
      "source": "kubernetes",
      "target": "talos",
      "type": "hostedBy",
      "strength": "required",
      "description": "The Kubernetes cluster runs on Talos Linux control-plane and worker nodes.",
      "evidence": [
        "docs/truenas-talos-bootstrap.md:default Talos VM topology and bootstrap sequence"
      ]
    },
    {
      "source": "etcd",
      "target": "talos",
      "type": "hostedBy",
      "strength": "required",
      "description": "Talos control-plane nodes host the etcd member(s) backing Kubernetes.",
      "evidence": [
        "docs/homelab-health-observability.md:current Talos control-plane and etcd topology"
      ]
    },
    {
      "source": "talos",
      "target": "truenas",
      "type": "hostedBy",
      "strength": "required",
      "description": "Talos control-plane and worker nodes are provisioned as VMs on TrueNAS.",
      "evidence": [
        "docs/truenas-talos-bootstrap.md:TrueNAS VM bridge and default Talos VM topology",
        "terraform/truenas/main.tf:truenas_vm"
      ]
    },
    {
      "source": "pfsense-unbound",
      "target": "pihole",
      "type": "dependsOn",
      "strength": "required",
      "description": "Private int.albandrieu.com resolution through pfSense/Unbound depends on the Pi-hole authority at 172.17.0.24:53; public recursion remains independent.",
      "evidence": [
        "docs/dns-ingress-ownership.md:Resolver architecture and precedence",
        "docs/dns-ingress-ownership.md:pfSense / Unbound"
      ]
    },
    {
      "source": "reactive-resume",
      "target": "redis",
      "type": "dependsOn",
      "strength": "required",
      "description": "Reactive Resume uses the shared Redis App at 172.17.0.24:30059.",
      "evidence": ["truenas:ix-reactive-resume-reactive-resume-1:REDIS_URL"]
    },
    {
      "source": "openclaw-gateway",
      "target": "litellm",
      "type": "consumesApi",
      "strength": "required",
      "description": "The Gateway calls LiteLLM and joins its external network ix-litellm_default, so it cannot start before LiteLLM.",
      "evidence": [
        "apps/openclaw/deploy/truenas/compose.yml:networks.litellm",
        "apps/openclaw/deploy/truenas/openclaw.json:models.providers"
      ]
    },
    {
      "source": "openclaw-gateway",
      "target": "openclaw-devbox",
      "type": "dependsOn",
      "strength": "required",
      "description": "The Gateway joins the external network openclaw-devbox created by the devbox App.",
      "evidence": ["apps/openclaw/deploy/truenas/compose.yml:networks.devbox"]
    },
    {
      "source": "openclaw-gateway",
      "target": "docker-socket-proxy",
      "type": "consumesApi",
      "strength": "required",
      "description": "The heartbeat reads Docker through the proxy and the Gateway joins its external network docker-proxy, so it cannot start before the proxy.",
      "evidence": [
        "apps/openclaw/deploy/truenas/compose.yml:networks.docker-proxy"
      ]
    },
    {
      "source": "openclaw-gateway",
      "target": "searxng",
      "type": "consumesApi",
      "strength": "optional",
      "description": "Gateway web search uses SearXNG and falls back to another backend (WEB_SEARCH_BACKEND=auto).",
      "evidence": ["truenas:openclaw-gateway:SEARXNG_BASE_URL"]
    },
    {
      "source": "openclaw-gateway",
      "target": "n8n",
      "type": "consumesApi",
      "strength": "optional",
      "description": "Gateway skills trigger n8n workflows.",
      "evidence": ["truenas:openclaw-gateway:N8N_BASE_URL"]
    }
  ]
}
