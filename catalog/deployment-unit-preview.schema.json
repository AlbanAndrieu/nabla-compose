{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Derived read-only Nabla deployment unit preview (not authoritative)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "units"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "const": "x-nabla-compose"
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      }
    }
  },
  "$defs": {
    "level": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        null
      ]
    },
    "endpoint": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composeService",
        "endpointId",
        "dependsOn"
      ],
      "properties": {
        "composeService": {
          "$ref": "#/$defs/endpoint"
        },
        "endpointId": {
          "oneOf": [
            {
              "$ref": "#/$defs/endpoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        }
      }
    },
    "probePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxConcurrentPerUnit",
        "primaryEndpointId",
        "secondaryEndpointIds",
        "execution"
      ],
      "properties": {
        "maxConcurrentPerUnit": {
          "const": 1
        },
        "primaryEndpointId": {
          "oneOf": [
            {
              "$ref": "#/$defs/endpoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "secondaryEndpointIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "execution": {
          "const": "serialized-on-demand"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentUnitId",
        "composePath",
        "containers",
        "endpointIds",
        "probePlan",
        "operationalCriticality",
        "businessCriticality",
        "stateful",
        "upgradePolicy",
        "watchtowerAutoCandidate",
        "watchtowerAutoEligible",
        "evidence"
      ],
      "properties": {
        "deploymentUnitId": {
          "type": "string",
          "pattern": "^truenas:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "composePath": {
          "type": "string",
          "pattern": "^apps/.+/compose\\.ya?ml$"
        },
        "containers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/container"
          }
        },
        "endpointIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "probePlan": {
          "$ref": "#/$defs/probePlan"
        },
        "operationalCriticality": {
          "$ref": "#/$defs/level"
        },
        "businessCriticality": {
          "$ref": "#/$defs/level"
        },
        "stateful": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "upgradePolicy": {
          "enum": [
            "excluded",
            "observe",
            "controlled",
            "automatic"
          ]
        },
        "watchtowerAutoCandidate": {
          "type": "boolean"
        },
        "watchtowerAutoEligible": {
          "const": false
        },
        "evidence": {
          "const": "declared-only"
        }
      }
    }
  }
}
