{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.albanandrieu.com/schemas/nabla-service-catalog-v2.schema.json",
  "title": "Nabla interoperable service catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "entities",
    "relations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiVersion": {
      "const": "nabla.dev/v2"
    },
    "kind": {
      "const": "ServiceCatalog"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "catalogRevision",
        "topologyVersion",
        "authoritativeSource",
        "state"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "catalogRevision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "topologyVersion": {
          "type": "integer",
          "minimum": 1
        },
        "authoritativeSource": {
          "const": "x-nabla"
        },
        "state": {
          "const": "declared"
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "entity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "ref",
        "name",
        "entityType",
        "subtype",
        "domain",
        "system",
        "sourcePath",
        "deploymentStatus",
        "standards"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "ref": {
          "type": "string",
          "pattern": "^nabla:(?:component|resource):"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "entityType": {
          "enum": [
            "component",
            "resource"
          ]
        },
        "subtype": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "const": "nabla-homelab"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "deploymentStatus": {
          "enum": [
            "active",
            "planned",
            "disabled"
          ]
        },
        "description": {
          "type": "string"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "url"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "external": {
                "type": "boolean"
              },
              "cloudflareTunnel": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "standards": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backstage",
            "cyclonedx"
          ],
          "properties": {
            "backstage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entityRef"
              ],
              "properties": {
                "entityRef": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "cyclonedx": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bomRef"
              ],
              "properties": {
                "bomRef": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "integrations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cartography"
          ],
          "properties": {
            "cartography": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "joinProperty",
                "joinValue"
              ],
              "properties": {
                "joinProperty": {
                  "const": "nabla_ref"
                },
                "joinValue": {
                  "type": "string",
                  "pattern": "^nabla:(?:component|resource):"
                }
              }
            }
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "target",
        "sourceRef",
        "targetRef",
        "type",
        "strength",
        "evidence"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/identifier"
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "targetRef": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "description": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
