{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":dependencyDashboard",
    ":enableVulnerabilityAlertsWithAdditionalLabel('security')",
    "group:recommended"
  ],
  "timezone": "Europe/Paris",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "prConcurrentLimit": 2,
  "branchConcurrentLimit": 2,
  "rebaseWhen": "auto",
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Batch npm runtime patch/minor updates weekly",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm runtime dependencies",
      "schedule": [
        "* 0-8 * * 1"
      ],
      "automerge": false
    },
    {
      "description": "Batch npm development patch/minor updates monthly",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm devDependencies",
      "schedule": [
        "* 0-8 1-7 * 1"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "description": "Batch Docker non-major updates weekly",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "Docker images",
      "schedule": [
        "* 0-8 * * 1"
      ],
      "automerge": false
    },
    {
      "description": "Batch GitHub Actions monthly",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "schedule": [
        "* 0-8 1-7 * 1"
      ],
      "automerge": false
    },
    {
      "description": "Require dashboard approval for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-8 1-7 * 1"
    ]
  },
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "prConcurrentLimit": 2,
    "automerge": false
  }
}
