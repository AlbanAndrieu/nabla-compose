# Copy values into your local shell, mise.local.toml, direnv, or secret manager.
# Never commit real credentials.

# @profanter-dev/truenas-mcp expects host[:port], without an https:// prefix.
TRUENAS_MCP_HOST=truenas.example.internal:443
TRUENAS_MCP_API_KEY=
# Keep false when the TrueNAS certificate is trusted. Set true only for a self-signed lab certificate you intentionally accept.
TRUENAS_MCP_INSECURE=false

# Stable Homarr currently uses /api/mcp/mcp; Homarr v2 prefers /api/mcp.
HOMARR_MCP_URL=https://homarr.example.internal/api/mcp/mcp
HOMARR_API_KEY=

# URL of a separately deployed adambenhassen/gatus-mcp server.
GATUS_MCP_URL=http://127.0.0.1:3000/mcp

UPTIME_KUMA_URL=https://uptime.example.internal
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=

# Optional local-only Bitwarden MCP. Configure bw against Vaultwarden first,
# then export the short-lived token returned by `bw unlock --raw`.
BW_SESSION=

# Optional override for root .mcp.json. The homelab default is the local TrueNAS runtime.
# Override with FastAPI Cloud only when the client is outside the trusted LAN.
FASTAPI_SAMPLE_MCP_URL=http://172.17.0.24:8091/mcp


# Self-hosted Sentry MCP (inspect-only). The repository MCP clients use the
# direct LAN endpoint http://172.17.0.24:9005 so Cloudflare Access/challenges do
# not interfere with Sentry API calls.
#
# IMPORTANT: use a Sentry User Auth Token, not a project DSN/security key.
# Minimum read-only scopes for the upstream inspect skill:
# org:read, project:read, team:read, event:read.
SENTRY_ACCESS_TOKEN=


# Optional public Cloudflare Access verification for protected homelab apps.
# These are the two credentials of a Cloudflare Access Service Token. They do
# not replace application-level credentials such as SENTRY_ACCESS_TOKEN.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
