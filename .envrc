#!/bin/bash
#
# Commands dependencies
# =====================
#
DIRENV_CMD_DEPENDENCIES="unzip tar mkdir curl chmod rm git make docker"
for mandatory_cmd in ${DIRENV_CMD_DEPENDENCIES}; do
  if [ -z "$(which ${mandatory_cmd})" ]; then
    echo "===> Mandatory command not found: ${mandatory_cmd}"
    exit 1
  fi
done

#
# Direnv configuration
# =====================
#

export DIRENV_TMP_DIR="${PWD}/.direnv"
export DIRENV_BIN_DIR="${DIRENV_TMP_DIR}/bin"
if [ ! -e "${DIRENV_BIN_DIR}" ]; then
  mkdir -p "${DIRENV_BIN_DIR}"
fi
export PATH="${DIRENV_BIN_DIR}:${PATH}"

# shellcheck disable=SC2086
DIRENV_PYTHON_LIBS_DIR_RELATIVE="$(find ${DIRENV_TMP_DIR} -type d -name site-packages)"

export VENV_TMP_DIR="${PWD}/.venv"
export VENV_BIN_DIR="${VENV_TMP_DIR}/bin"

# python package are in venv
if [ ! -e "${DIRENV_PYTHON_LIBS_DIR_RELATIVE}" ]; then
  # shellcheck disable=SC2086
  DIRENV_PYTHON_LIBS_DIR_RELATIVE="$(find ${VENV_TMP_DIR} -type d -name site-packages)"
fi
# shellcheck disable=SC2155
export DIRENV_PYTHON_LIBS_DIR="$(realpath ${DIRENV_PYTHON_LIBS_DIR_RELATIVE})"

if type lsb_release >/dev/null 2>&1; then
  # linuxbase.org
  OS=$(lsb_release -si)
  # shellcheck disable=SC2034
  VER=$(lsb_release -sr)
fi

#
# Other configuration
# =====================
#

#
# Node configuration
# =====================
#

export NODE_VERSIONS=${NODE_VERSIONS:-"v24.22.1"}

if [ -f ".nvmrc" ]; then
  #
  # Nvm installation
  # ==========================
  #
  # Entering the directory must not download and execute remote installers
  # (unpinned, unverified `curl | bash`). Node comes from mise.toml/mise.lock.
  if [ ! -e "${HOME}/.nvm/nvm.sh" ] && ! command -v mise >/dev/null 2>&1; then
    echo "⚠️  Node ${NODE_VERSIONS} is not provisioned: install mise, then run 'mise install'"
  fi

  # shellcheck disable=SC1091
  # source "${HOME}/.nvm/nvm.sh"
  # nvm use ${NODE_VERSIONS}
fi

layout_node

# Either use node version specified in package.json
#use node package.json

#
# Python configuration
# =====================
#

export PYTHON_VERSION=${PYTHON_VERSION:-"3.14"}

#
# Python pyenv installation
# ==========================
#
# Python comes from mise.toml/mise.lock; never pipe a remote installer to bash.
if [ ! -e "${HOME}/.pyenv/bin/pyenv" ] && ! command -v mise >/dev/null 2>&1; then
  echo "⚠️  Python ${PYTHON_VERSION} is not provisioned: install mise, then run 'mise install'"
fi

#
# Python 2 requirements
# ==========================
#
if command -v pyenv >/dev/null 2>&1; then
  #
  # Python pip requirements
  # ==========================
  #
  # Unpinned `pip install` on every directory entry was removed; Python 2
  # environments are legacy. Install py2venv manually if one is still needed.
  if pyenv versions --bare | grep -qE '^2\.'; then
    echo "ℹ️  Python 2 detected in pyenv: install py2venv manually if needed"
  fi

  #
  # Python pip upgrade
  # ==========================
  #
  # curl https://bootstrap.pypa.io/get-pip.py -o get-pip.py
  for VERSION in $(pyenv versions --bare); do
    pyenv shell "${VERSION}" 2>/dev/null
    # pip install --upgrade pip
  done
fi

# check if python version is set in current dir
# .python-version will be created by : pyenv local ${PYTHON_VERSION}
if [ -f ".python-version" ]; then
  if [ ! -d "${VENV_TMP_DIR}" ]; then
    echo "Installing virtualenv for $(cat .python-version)"
    # if we didn't install `py2venv` for python 2.x, we would need to use
    # `virtualenv`, which you would have to install separately.
    python -m venv ${VENV_TMP_DIR}
  fi
  echo "Activating $(cat .python-version) virtualenv"
  source ${VENV_BIN_DIR}/activate
  # announce python version and show the path of the current python in ${PATH}
  echo "Virtualenv has been activated for $(cat .python-version)"
  # echo "$(which python)"
fi

# if pyenv and venv
if [ -f ".python-version" ]; then
  #
  # Python tooling (pytest, pre-commit, ...) is declared in pyproject.toml
  # and locked in uv.lock. Ansible tooling: `uv sync --group ansible`.
  # ==========================
  #
  if command -v uv >/dev/null 2>&1; then
    echo "👉 uv sync --frozen (or: mise run deps)"
  else
    echo "⚠️  uv not found: run 'mise install' then 'mise run deps'"
  fi
fi

if command -v pyenv >/dev/null 2>&1; then
  # layout pyenv "${PYTHON_VERSION}"
  layout pyenv
elif command -v conda >/dev/null 2>&1; then
  layout_anaconda
  echo "pip3 install chardet"
  echo "conda create -n textgen python=${PYTHON_VERSION}"
  conda activate textgen
else
  layout_python3
fi

use mise

#
# Environment configuration
# =========================
#
#
DOTENV_ADDONS=".env .env.secrets"
# shellcheck disable=SC2155
for addon in ${DOTENV_ADDONS}; do
  if [ -e "${PWD}/${addon}" ]; then
    dotenv "${PWD}/${addon}"
  fi
done

ENV_ADDONS=".env.local"
for addon in ${ENV_ADDONS}; do
  if [ -e "${PWD}/${addon}" ]; then
    # shellcheck disable=SC1090
    source "${PWD}/${addon}"
  fi
done

# See https://github.com/direnv/direnv/wiki/PS1
unset PS1
