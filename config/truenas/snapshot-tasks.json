{
  "description": "ZFS snapshot retention policy approved on 2026-11-03. Every class dataset gets one TrueNAS periodic snapshot task per schedule; datasets listed in noSnapshot must not be covered by any task. See docs/truenas-zfs-snapshot-policy.md.",
  "schedules": {
    "hourly-24h": {
      "naming_schema": "auto-hourly-%Y-%m-%d_%H-%M",
      "lifetime_value": 24,
      "lifetime_unit": "HOUR",
      "allow_empty": false,
      "schedule": {
        "minute": "15",
        "hour": "*",
        "dom": "*",
        "month": "*",
        "dow": "*"
      }
    },
    "hourly-48h": {
      "naming_schema": "auto-hourly-%Y-%m-%d_%H-%M",
      "lifetime_value": 48,
      "lifetime_unit": "HOUR",
      "allow_empty": false,
      "schedule": {
        "minute": "15",
        "hour": "*",
        "dom": "*",
        "month": "*",
        "dow": "*"
      }
    },
    "daily-7d": {
      "naming_schema": "auto-daily-%Y-%m-%d_%H-%M",
      "lifetime_value": 7,
      "lifetime_unit": "DAY",
      "allow_empty": false,
      "schedule": {
        "minute": "30",
        "hour": "2",
        "dom": "*",
        "month": "*",
        "dow": "*"
      }
    },
    "daily-14d": {
      "naming_schema": "auto-daily-%Y-%m-%d_%H-%M",
      "lifetime_value": 14,
      "lifetime_unit": "DAY",
      "allow_empty": false,
      "schedule": {
        "minute": "0",
        "hour": "3",
        "dom": "*",
        "month": "*",
        "dow": "*"
      }
    },
    "daily-30d": {
      "naming_schema": "auto-daily-%Y-%m-%d_%H-%M",
      "lifetime_value": 30,
      "lifetime_unit": "DAY",
      "allow_empty": false,
      "schedule": {
        "minute": "30",
        "hour": "2",
        "dom": "*",
        "month": "*",
        "dow": "*"
      }
    },
    "weekly-8w": {
      "naming_schema": "auto-weekly-%Y-%m-%d_%H-%M",
      "lifetime_value": 8,
      "lifetime_unit": "WEEK",
      "allow_empty": false,
      "schedule": {
        "minute": "30",
        "hour": "3",
        "dom": "*",
        "month": "*",
        "dow": "sun"
      }
    },
    "weekly-12w": {
      "naming_schema": "auto-weekly-%Y-%m-%d_%H-%M",
      "lifetime_value": 12,
      "lifetime_unit": "WEEK",
      "allow_empty": false,
      "schedule": {
        "minute": "30",
        "hour": "3",
        "dom": "*",
        "month": "*",
        "dow": "sun"
      }
    },
    "monthly-12m": {
      "naming_schema": "auto-monthly-%Y-%m-%d_%H-%M",
      "lifetime_value": 12,
      "lifetime_unit": "MONTH",
      "allow_empty": false,
      "schedule": {
        "minute": "0",
        "hour": "4",
        "dom": "1",
        "month": "*",
        "dow": "*"
      }
    }
  },
  "classes": [
    {
      "name": "critical",
      "rationale": "Secrets and credentials: short RPO, plus an encrypted off-site copy (roadmap step 4).",
      "schedules": ["hourly-48h", "daily-30d"],
      "datasets": ["cpool/2fauth", "cpool/secrets", "cpool/vaultwarden"]
    },
    {
      "name": "databases",
      "rationale": "Crash-consistent stores; application dumps remain the reference restore path.",
      "schedules": ["hourly-24h", "daily-7d"],
      "datasets": [
        "cpool/clickhouse",
        "cpool/elasticsearch",
        "cpool/graylog",
        "cpool/mongo",
        "cpool/neo4j",
        "cpool/nexus3",
        "cpool/opensearch",
        "cpool/opensearch-security",
        "cpool/sentry-clickhouse",
        "cpool/wazuh"
      ]
    },
    {
      "name": "backup-targets",
      "rationale": "Restic and S3 backup targets: protects them against a client that deletes its own repository over NFS/S3.",
      "schedules": ["daily-14d", "weekly-8w"],
      "datasets": ["cpool/backup", "cpool/garage"]
    },
    {
      "name": "app-state",
      "rationale": "Small configuration and application state under /mnt/cpool/<service>.",
      "schedules": ["daily-30d", "weekly-12w"],
      "datasets": [
        "cpool/autokuma",
        "cpool/autoxpose",
        "cpool/bazarr",
        "cpool/bichon",
        "cpool/code",
        "cpool/cyberbro",
        "cpool/ddns-updater",
        "cpool/defectdojo",
        "cpool/dependency-track",
        "cpool/dockhand",
        "cpool/dococd",
        "cpool/dozzle",
        "cpool/dsomm",
        "cpool/gatus",
        "cpool/grafana",
        "cpool/hermes",
        "cpool/homarr",
        "cpool/jellyfin",
        "cpool/keycloak",
        "cpool/langflow",
        "cpool/lidarr",
        "cpool/litellm",
        "cpool/minio",
        "cpool/netbox",
        "cpool/nginx",
        "cpool/npm",
        "cpool/npmplus",
        "cpool/obsidian",
        "cpool/opconnect",
        "cpool/opencre",
        "cpool/openhands",
        "cpool/openwebui",
        "cpool/pihole",
        "cpool/portracker",
        "cpool/prowlarr",
        "cpool/qbittorrent",
        "cpool/radarr",
        "cpool/recyclarr",
        "cpool/scanopy",
        "cpool/scrutiny",
        "cpool/seerr",
        "cpool/sentry",
        "cpool/sonarr",
        "cpool/traefik"
      ]
    },
    {
      "name": "user-data",
      "rationale": "Documents and media owned by people, not by an application. Add photo/music/www datasets after the retention audit gives their exact names.",
      "schedules": ["daily-30d", "monthly-12m"],
      "datasets": ["cpool/bababou"]
    }
  ],
  "noSnapshot": [
    {
      "dataset": "cpool/akvorado",
      "reason": "Network flow analytics, regenerated from live traffic."
    },
    {
      "dataset": "cpool/alloy",
