{
  "key_alias": "hermes-poc",
  "models": [
    "hermes-opus-5-5",
    "hermes-opus-5",
    "hermes-opus-4-8",
    "hermes-openai"
  ],
  "rpm_limit": 5,
  "tpm_limit": 10000,
  "max_parallel_requests": 1,
  "metadata": {
    "workload": "hermes",
    "environment": "poc",
    "managed_by": "nabla-compose",
    "identity": "service",
    "routing_policy": "anthropic_opus_first_openai_last",
    "upstream_secret_owner": "litellm_only",
    "activation": "disabled_until_credentials_cost_and_privacy_gates_pass"
  },
  "monthly_budget": {
    "amount": 20,
    "currency": "EUR",
    "period": "calendar_month",
    "enforcement": "convert_to_litellm_usd_at_provisioning"
  }
}
