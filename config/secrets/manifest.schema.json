{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://albandrieu.com/schemas/nabla-compose/secrets-manifest.schema.json",
  "title": "Nabla Compose secret manifest",
  "type": "object",
  "required": ["schemaVersion", "server", "folder", "items"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "server": {
      "type": "string",
      "pattern": "^https://"
    },
    "folder": {
      "type": "object",
      "required": ["name", "id"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "id": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "bootstrap": {
      "type": "array"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["app", "item", "secrets"],
        "not": {
          "anyOf": [
            {"required": ["value"]},
            {"required": ["password"]},
            {"required": ["token"]},
            {"required": ["secretValue"]}
          ]
        },
        "properties": {
          "app": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "item": {
            "type": "string",
            "pattern": "\\S"
          },
          "secrets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["env"],
              "not": {
                "anyOf": [
                  {"required": ["value"]},
                  {"required": ["password"]},
                  {"required": ["token"]},
                  {"required": ["secretValue"]}
                ]
              },
              "properties": {
                "env": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "importEnv": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "enum": ["field", "login.password", "login.username"]
                },
                "rotation": {
                  "enum": ["preserve", "rotatable"]
                },
                "allowEmpty": {
                  "type": "boolean"
                },
                "critical": {
                  "type": "boolean"
                }
              },
              "allOf": [
                {
                  "if": {
                    "anyOf": [
                      {
                        "not": {
                          "required": ["source"]
                        }
                      },
                      {
                        "required": ["source"],
                        "properties": {
                          "source": {
                            "const": "field"
                          }
                        }
                      }
                    ]
                  },
                  "then": {
                    "required": ["field"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
