{
  "schemaVersion": 1,
  "server": "https://vaultwarden.albandrieu.com",
  "services": {
    "2fauth": [
      {
        "env": "TWOFAUTH_APP_KEY",
        "item": "nabla/homelab/2fauth",
        "field": "APP_KEY",
        "required": true,
        "rotation": "preserve"
      }
    ],
    "open-terminal": [
      {
        "env": "OPEN_TERMINAL_API_KEY",
        "item": "nabla/homelab/open-terminal",
        "field": "OPEN_TERMINAL_API_KEY",
        "required": true,
        "rotation": "preserve-until-cutover"
      }
    ],
    "karakeep": [
      {
        "env": "KARAKEEP_NEXTAUTH_SECRET",
        "item": "nabla/homelab/karakeep",
        "field": "NEXTAUTH_SECRET",
        "required": true,
        "rotation": "preserve"
      },
      {
        "env": "KARAKEEP_MEILI_MASTER_KEY",
        "item": "nabla/homelab/karakeep",
        "field": "MEILI_MASTER_KEY",
        "required": true,
        "rotation": "preserve"
      },
      {
        "env": "KARAKEEP_OPENAI_API_KEY",
        "item": "nabla/homelab/karakeep",
        "field": "OPENAI_API_KEY",
        "required": false,
        "rotation": "rotatable"
      }
    ],
    "reactive-resume": [
      {
        "env": "REACTIVE_RESUME_DATABASE_PASSWORD",
        "item": "nabla/homelab/reactive-resume",
        "field": "DATABASE_PASSWORD",
        "required": true,
        "rotation": "preserve-until-db-cutover"
      },
      {
        "env": "REACTIVE_RESUME_AUTH_SECRET",
        "item": "nabla/homelab/reactive-resume",
        "field": "AUTH_SECRET",
        "required": true,
        "rotation": "preserve"
      },
      {
        "env": "REACTIVE_RESUME_ENCRYPTION_SECRET",
        "item": "nabla/homelab/reactive-resume",
        "field": "ENCRYPTION_SECRET",
        "required": true,
        "rotation": "preserve"
      },
      {
        "env": "REACTIVE_RESUME_REDIS_PASSWORD",
        "item": "nabla/homelab/reactive-resume",
        "field": "REDIS_PASSWORD",
        "required": true,
        "rotation": "preserve-until-cutover"
      }
    ],
    "postgres": [
      {
        "env": "POSTGRES_PASSWORD",
        "item": "nabla/homelab/postgres",
        "field": "POSTGRES_PASSWORD",
        "required": true,
        "rotation": "preserve-until-db-cutover"
      }
    ],
    "keycloak": [
      {
        "env": "KEYCLOAK_DB_PASSWORD",
        "item": "nabla/homelab/keycloak",
        "field": "DB_PASSWORD",
        "required": true,
        "rotation": "rotatable"
      },
      {
        "env": "KEYCLOAK_GITHUB_CLIENT_SECRET",
        "item": "nabla/homelab/keycloak",
        "field": "GITHUB_CLIENT_SECRET",
        "required": true,
        "rotation": "rotatable"
      }
    ]
  }
}
