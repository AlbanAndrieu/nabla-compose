{
  "schemaVersion": 1,
  "server": "https://vaultwarden.albandrieu.com",
  "bootstrap": [
    {
      "app": "vaultwarden",
      "env": "VAULTWARDEN_ADMIN_TOKEN",
      "source": "host-protected",
      "reason": "Vaultwarden must start before workload secrets can be read from it"
    },
    {
      "app": "vaultwarden",
      "env": "VAULTWARDEN_SMTP_USERNAME",
      "source": "host-protected",
      "reason": "Vaultwarden must start before workload secrets can be read from it"
    },
    {
      "app": "vaultwarden",
      "env": "VAULTWARDEN_SMTP_PASSWORD",
      "source": "host-protected",
      "reason": "Vaultwarden must start before workload secrets can be read from it"
    },
    {
      "app": "bitwarden-api",
      "env": "BW_CLIENTID",
      "source": "host-protected",
      "legacy": true,
      "reason": "Legacy Doco-CD adapter bootstrap until direct bw-based workflows replace it"
    },
    {
      "app": "bitwarden-api",
      "env": "BW_CLIENTSECRET",
      "source": "host-protected",
      "legacy": true,
      "reason": "Legacy Doco-CD adapter bootstrap until direct bw-based workflows replace it"
    },
    {
      "app": "bitwarden-api",
      "env": "BW_PASSWORD",
      "source": "host-protected",
      "legacy": true,
      "reason": "Legacy Doco-CD adapter bootstrap until direct bw-based workflows replace it"
    }
  ],
  "items": [
    {
      "app": "2fauth",
      "item": "nabla/prod/2fauth",
      "secrets": [
        {
          "env": "TWOFAUTH_APP_KEY",
          "field": "APP_KEY",
          "critical": true,
          "rotation": "preserve"
        }
      ]
    },
    {
      "app": "open-terminal",
      "item": "nabla/prod/open-terminal",
      "secrets": [
        {
          "env": "OPEN_TERMINAL_API_KEY",
          "field": "OPEN_TERMINAL_API_KEY",
          "critical": true,
          "rotation": "preserve"
        }
      ]
    },
    {
      "app": "karakeep",
      "item": "nabla/prod/karakeep",
      "secrets": [
        {
          "env": "KARAKEEP_NEXTAUTH_SECRET",
          "field": "NEXTAUTH_SECRET",
          "critical": true,
          "rotation": "preserve"
        },
        {
          "env": "KARAKEEP_MEILISEARCH_MASTER_KEY",
          "field": "MEILI_MASTER_KEY",
          "critical": true,
          "rotation": "preserve"
        },
        {
          "env": "KARAKEEP_OPENAI_API_KEY",
          "field": "OPENAI_API_KEY",
          "critical": false,
          "rotation": "rotatable"
        }
      ]
    },
    {
      "app": "reactive-resume",
      "item": "nabla/prod/reactive-resume",
      "secrets": [
        {
          "env": "REACTIVE_RESUME_DATABASE_PASSWORD",
          "field": "DATABASE_PASSWORD",
          "critical": true,
          "rotation": "preserve"
        },
        {
          "env": "REACTIVE_RESUME_AUTH_SECRET",
          "field": "AUTH_SECRET",
          "critical": true,
          "rotation": "preserve"
        },
        {
          "env": "REACTIVE_RESUME_ENCRYPTION_SECRET",
          "field": "ENCRYPTION_SECRET",
          "critical": true,
          "rotation": "preserve"
        },
        {
          "env": "REACTIVE_RESUME_REDIS_PASSWORD",
          "field": "REDIS_PASSWORD",
          "critical": true,
          "rotation": "preserve"
        }
      ]
    }
  ]
}
