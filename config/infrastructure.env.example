# Non-secret infrastructure bootstrap configuration.
# Copy/adapt these dotenv assignments in .env.local. Never put credential values in this file.

TRUENAS_ENABLED=true
TRUENAS_URL=https://truenas.example.internal
TRUENAS_INFRA_API_USERNAME=albandrieu
# Optional overrides; repository defaults are cpool and br0.
TRUENAS_POOL=cpool
TRUENAS_VM_BRIDGE=br0
TALOS_VM_AUTOSTART=true
TALOS_ISO_PATH=/mnt/cpool/iso/talos-amd64.iso
TRUENAS_READ_ONLY=true
TRUENAS_DESTROY_PROTECTION=true
TRUENAS_INSECURE_SKIP_VERIFY=false

# Optional non-secret Garage backend overrides.
GARAGE_S3_ENDPOINT=https://s3.int.albandrieu.com
GARAGE_ADMIN_ENDPOINT=https://garage-admin.int.albandrieu.com
GARAGE_STATE_BUCKET=opentofu-state

# Optional location for sensitive pre-apply state snapshots.
# Prefer an encrypted operator-controlled filesystem.
# NABLA_STATE_BACKUP_DIR=$HOME/.local/state/nabla-compose/opentofu-state-backups

# Secret variables are intentionally omitted and should be rendered from Vaultwarden:
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# GARAGE_ADMIN_TOKEN
# TRUENAS_INFRA_API_KEY

# Do not reuse FastAPI observer credentials here:
# TRUENAS_API_USERNAME=fastapi_observer and TRUENAS_API_KEY belong to apps/sample only.
