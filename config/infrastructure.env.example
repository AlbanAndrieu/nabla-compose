# Non-secret infrastructure bootstrap configuration.
# Copy/adapt these exports in .env.local. Never put credential values in this file.

export TRUENAS_ENABLED=true
export TRUENAS_URL=https://truenas.example.internal
export TRUENAS_USERNAME=tofu_truenas
export TRUENAS_POOL=cpool
export TRUENAS_VM_BRIDGE=br0
export TALOS_ISO_PATH=/mnt/cpool/iso/talos-amd64.iso
export TRUENAS_READ_ONLY=true
export TRUENAS_DESTROY_PROTECTION=true
export TRUENAS_INSECURE_SKIP_VERIFY=false

# Optional non-secret Garage backend overrides.
export GARAGE_S3_ENDPOINT=https://s3.int.albandrieu.com
export GARAGE_STATE_BUCKET=opentofu-state

# Optional location for sensitive pre-apply state snapshots.
# Prefer an encrypted operator-controlled filesystem.
# export NABLA_STATE_BACKUP_DIR=$HOME/.local/state/nabla-compose/opentofu-state-backups

# Secret variables are intentionally omitted and should be rendered from Vaultwarden:
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# GARAGE_ADMIN_TOKEN
# TRUENAS_API_KEY
