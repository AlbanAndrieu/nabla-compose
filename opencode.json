{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-4.1-mini",
  "small_model": "openai/gpt-4.1-mini",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-4.1-mini",
      "prompt": "{file:./.opencode/prompts/build.txt}"
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm -rf *": "ask",
      "git clean -fd*": "ask",
      "git reset --hard*": "ask",
      "git push *": "ask",
      "git push --force*": "ask",
      "git push --no-verify*": "deny",
      "git push * --no-verify*": "deny"
    }
  }
}
