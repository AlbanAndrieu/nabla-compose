{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-4.1-mini",
  "default_agent": "build",
  "share": "disabled",
  "agents": {
    "build": {
      "description": "Deterministic nabla-compose implementation agent",
      "mode": "primary",
      "model": "openai/gpt-4.1-mini",
      "steps": 48
    },
    "title": {
      "model": "openai/gpt-4.1-mini"
    },
    "summary": {
      "model": "openai/gpt-4.1-mini"
    },
    "compaction": {
      "model": "openai/gpt-4.1-mini"
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.env.example",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/.env.example",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "subagent",
      "resource": "reviewer",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git ls-files *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rev-parse *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "python scripts/agent-task-context.py *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "python scripts/check-service-migration-bundle.py *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "python -m unittest *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "python -m pytest *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "mise run agent-context *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "mise run agent-fix *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "mise run agent-quality *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "mise run agent-pre-push *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pre-commit run *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean -fd*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push * --force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push --no-verify*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push * --no-verify*",
      "effect": "deny"
    }
  ]
}
